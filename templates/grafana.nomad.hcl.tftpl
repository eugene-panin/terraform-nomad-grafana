job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "grafana" {
    network {
      mode = "bridge"

      port "http" {
        to           = ${http_port}
        host_network = "${internal_network}"
      }
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "http"
      provider = "consul"
      tags = [
        "traefik.enable=true",
        "traefik.http.routers.${job_name}.rule=Host(`${hostname}`)",
        "traefik.http.routers.${job_name}.entrypoints=${traefik.entrypoint}",
        "traefik.http.routers.${job_name}.tls=true",
        "traefik.http.routers.${job_name}.tls.certresolver=${traefik.certresolver}",
      ]

      check {
        type     = "http"
        path     = "/api/health"
        interval = "15s"
        timeout  = "5s"
      }
    }

    task "grafana" {
      driver = "docker"
      user   = "472:472"

      config {
        image    = "${image}"
        cap_drop = ["all"]
      }

      volume_mount {
        volume      = "data"
        destination = "/var/lib/grafana"
      }

      vault {}

      env {
        GF_PATHS_PROVISIONING                = "/local/provisioning"
        GF_SERVER_ROOT_URL                   = "https://${hostname}"
        GF_AUTH_ANONYMOUS_ENABLED            = "${anonymous_viewer}"
        GF_AUTH_ANONYMOUS_ORG_ROLE           = "Viewer"
        GF_ANALYTICS_REPORTING_ENABLED       = "false"
        GF_ANALYTICS_CHECK_FOR_UPDATES       = "false"
        GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES = "false"
      }

      template {
        destination = "secrets/grafana.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}GF_SECURITY_ADMIN_PASSWORD={{ .Data.data.password }}{{ end }}
        EOT
      }

      template {
        destination = "local/provisioning/datasources/datasources.yaml"
        data        = <<-DS
${datasources_yaml}
        DS
      }

      resources {
        cpu    = ${resources.cpu}
        memory = ${resources.memory}
      }
    }
  }
}
