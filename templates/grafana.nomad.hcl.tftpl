job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "grafana" {
    network {
      mode = "bridge"
%{ if length(dns_servers) > 0 ~}

      # Consul's DNS, which answers the data sources' service names and forwards
      # the rest, so Grafana finds Mimir and Loki wherever they run.
      dns {
        servers = ${jsonencode(dns_servers)}
      }
%{ endif ~}

      port "http" {
        to           = ${http_port}
        host_network = "${internal_network}"
      }
%{ if mesh.enabled ~}

      # Envoy's metrics, scraped by the platform's Alloy for Consul's topology.
      port "envoy_metrics" {
        to           = 9102
        host_network = "${internal_network}"
      }
%{ endif ~}
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "http"
      provider = "consul"
      tags = [
        "traefik.enable=true",
        "traefik.http.routers.${job_name}.rule=Host(`${hostname}`)",
        "traefik.http.routers.${job_name}.entrypoints=${traefik.entrypoint}",
        "traefik.http.routers.${job_name}.tls=true",
        "traefik.http.routers.${job_name}.tls.certresolver=${traefik.certresolver}",
      ]
%{ if mesh.enabled ~}

      # In the mesh: an Envoy sidecar (transparent proxy), so Grafana reaches its
      # data sources as <name>.virtual.consul, over mTLS, as their intentions
      # allow. Its own port stays open: Traefik, outside the mesh, routes to it.
      connect {
        sidecar_service {
          # Its own tags: the sidecar takes the service's otherwise, and a
          # second service carrying the same Traefik router makes Traefik drop it.
          tags = ["mesh-sidecar"]

          proxy {
            # The port inside the group: Envoy passes the mesh's traffic to it there,
            # not to the (dynamic) host port the service is registered with.
            local_service_port = ${http_port}

            transparent_proxy {
              # Envoy runs as uid 1337, which no app uses: the transparent proxy
              # lets Envoy's own uid out unredirected.
              uid                   = "1337"
              no_dns                = true
              exclude_inbound_ports = ${jsonencode([tostring(http_port), "9102"])}
            }
            config {
              envoy_prometheus_bind_addr = "0.0.0.0:9102"
            }
          }
        }

        sidecar_task {
          env {
            ENVOY_UID = "1337"
          }

          resources {
            cpu        = 50
            memory     = 32
            memory_max = 128
          }
        }
      }
%{ endif ~}

      check {
        type     = "http"
        path     = "/api/health"
        interval = "15s"
        timeout  = "5s"
      }
    }
%{ if mesh.enabled ~}

    service {
      name     = "${job_name}-envoy"
      port     = "envoy_metrics"
      provider = "consul"
      tags     = ["metrics"]
    }
%{ endif ~}

    task "grafana" {
      driver = "docker"
      user   = "472:472"

      config {
        image    = "${image}"
        cap_drop = ["all"]
      }

      volume_mount {
        volume      = "data"
        destination = "/var/lib/grafana"
      }

      vault {}

      env {
        GF_PATHS_PROVISIONING                = "/local/provisioning"
        GF_SERVER_ROOT_URL                   = "https://${hostname}"
        GF_AUTH_ANONYMOUS_ENABLED            = "${anonymous_viewer}"
        GF_AUTH_ANONYMOUS_ORG_ROLE           = "Viewer"
        GF_ANALYTICS_REPORTING_ENABLED       = "false"
        GF_ANALYTICS_CHECK_FOR_UPDATES       = "false"
        GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES = "false"
%{ if oidc != null ~}
        # Sign-in through an OIDC provider (Vault's, on the platform): those in its
        # admin group are Admins, anyone else it lets through is refused.
        GF_AUTH_GENERIC_OAUTH_ENABLED             = "true"
        GF_AUTH_GENERIC_OAUTH_NAME                = "${oidc.name}"
        GF_AUTH_GENERIC_OAUTH_CLIENT_ID           = "${oidc.client_id}"
        GF_AUTH_GENERIC_OAUTH_SCOPES              = "${join(" ", oidc.scopes)}"
        GF_AUTH_GENERIC_OAUTH_AUTH_URL            = "${oidc.auth_url}"
        GF_AUTH_GENERIC_OAUTH_TOKEN_URL           = "${oidc.token_url}"
        GF_AUTH_GENERIC_OAUTH_API_URL             = "${oidc.api_url}"
        GF_AUTH_GENERIC_OAUTH_USE_PKCE            = "true"
        GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP       = "true"
        GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH = "email"
        GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH = "email"
        GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH  = "email"
        GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH = "groups"
        GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH  = "contains(groups[*], '${oidc.admin_group}') && 'Admin' || ''"
        GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT = "true"
%{ endif ~}
      }

      template {
        destination = "secrets/grafana.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}GF_SECURITY_ADMIN_PASSWORD={{ .Data.data.password }}{{ end }}
%{ if oidc != null ~}
          {{ with secret "${secret_path}" }}GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ .Data.data.oidc_client_secret }}{{ end }}
%{ endif ~}
        EOT
      }

      template {
        destination = "local/provisioning/datasources/datasources.yaml"
        data        = <<-DS
${datasources_yaml}
        DS
      }

      resources {
        cpu        = ${resources.cpu}
        memory     = ${resources.memory}
        memory_max = ${resources.memory_max}
      }
    }
  }
}
